<?xml version="1.0" encoding="utf-8"?>
<!--
  Public-only package sources for this repository.

  The <clear /> is load-bearing: without it, machine-level NuGet.Config sources are
  MERGED in rather than replaced. This workstation has private feeds configured
  (an artifacts folder and the Visual Studio offline packages), which the GitHub
  Actions runner cannot reach - a package resolving from one of them would restore
  fine locally and fail in CI with a confusing error.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
