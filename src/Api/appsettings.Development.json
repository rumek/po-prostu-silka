{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // TrustServerCertificate=True is required: the Docker SQL Server image uses a
    // self-signed certificate, and the connection fails without it. Do NOT carry
    // this flag into any Azure connection string.
    "Default": "Server=localhost,1433;Database=po-prostu-silka;User ID=sa;Password=LocalDev_Pass123;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  // The app's own origin from launchSettings.json. The SPA is served from this app's wwwroot, so
  // one host serves both the API and the /reset-password route a link has to land on.
  "App": {
    "BaseUrl": "http://localhost:5264"
  },
  // Development-only admin credentials, deliberately committed - they seed the local Docker
  // database and guard nothing, exactly like the docker-compose SA password. Production supplies
  // its own via the App Service app settings AdminSeed__Email / AdminSeed__Password.
  "AdminSeed": {
    "Email": "admin@poprostusilka.local",
    "Password": "LocalAdmin_Pass123"
  },
  // Development-only test-data password, deliberately committed for the reason AdminSeed's is: it
  // guards nothing but the local Docker database. Set Enabled and Reset to true once to (re)seed,
  // then Reset back to false. Azure supplies its own via TestDataSeed__Password.
  "TestDataSeed": {
    "Enabled": false,
    "Reset": false,
    "Password": "LocalTest_Pass123"
  }
}
