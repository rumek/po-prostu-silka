<Project>

  <!--
    Shared properties for the four backend projects (Domain, Application, Infrastructure, Api).
    Holds them once instead of four times, so the next TargetFramework bump touches one file.

    tests/po-prostu-silka.Tests.csproj sits OUTSIDE src/ and deliberately keeps its own copy of
    these three properties. Pulling the test project under a shared props file is a separate
    decision this slice does not make.

    Deliberately absent: <Using Include="..." /> items. Those are declared per project, because
    Domain must not silently inherit the ASP.NET namespaces it has no business knowing about -
    that inheritance is exactly the kind of quiet generosity this split exists to remove.

    Also deliberately absent: TreatWarningsAsErrors. The repo is warning-clean today by a manual
    bar; changing the bar is not this slice's business.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
