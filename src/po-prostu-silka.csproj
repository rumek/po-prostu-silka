<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>po_prostu_silka</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="app\**" />
    <Content Remove="app\**" />
    <EmbeddedResource Remove="app\**" />
    <None Remove="app\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Design-time only: generates migrations, must not flow to the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <!--
      EF Core-backed Identity store. The core Identity services and the cookie handler ship in the
      ASP.NET Core shared framework, so this is the only package needed.
      Microsoft.AspNetCore.Identity.UI is deliberately absent: it scaffolds Razor Pages for a
      server-rendered login, and this app authenticates an Angular SPA through its own endpoints.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <!-- Azure Communication Services email. Sends through the Azure Managed Domain provisioned in
         F-03 phase 1; the sender address is configuration, not a constant. -->
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <!--
      Web Push with VAPID. Chosen over the more widely-cited "WebPush" package deliberately: this one
      is actively maintained and integrates with IHttpClientFactory, where WebPush 1.0.x is
      effectively dormant. Do not swap it back without re-checking that.
    -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
  </ItemGroup>

</Project>
